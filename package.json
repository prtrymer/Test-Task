{
  "name": "acme-data-room",
  "version": "0.1.0",
  "private": true,
  "description": "Data Room \u2014 secure document repository for due diligence",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run start:dev --workspace @data-room/api",
    "dev:web": "npm run dev --workspace @data-room/web",
    "build": "npm run build --workspace @data-room/api && npm run build --workspace @data-room/web",
    "test": "npm run test --workspace @data-room/api",
    "db:migrate": "npm run db:migrate --workspace @data-room/api",
    "db:studio": "npm run db:studio --workspace @data-room/api",
    "db:generate": "npm run db:generate --workspace @data-room/api"
  }
}
