generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities     AuthIdentity[]
  dataRooms      DataRoom[]
  sharesCreated  Share[]        @relation("ShareCreator")
  sharesReceived Share[]        @relation("ShareGrantee")
  uploads        FileVersion[]

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  passwordHash   String?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model DataRoom {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folders Folder[]
  files   File[]
  shares  Share[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("data_rooms")
}

model Folder {
  id         String  @id @default(uuid()) @db.Uuid
  dataRoomId String  @db.Uuid
  parentId   String? @db.Uuid
  name       String
  path  String
  depth Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataRoom DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  files    File[]
  shares   Share[]
  @@unique([parentId, name])
  @@index([dataRoomId, parentId, name])
  @@index([dataRoomId, path(ops: raw("text_pattern_ops"))])
  @@map("folders")
}

model File {
  id         String  @id @default(uuid()) @db.Uuid
  dataRoomId String  @db.Uuid
  folderId   String? @db.Uuid
  name       String
  path String
  sizeBytes     BigInt
  contentType   String
  blobPathname  String
  versionNumber Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataRoom DataRoom      @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder   Folder?       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  versions FileVersion[]
  shares   Share[]
  @@unique([folderId, name])
  @@index([dataRoomId, folderId, name])
  @@index([dataRoomId, path(ops: raw("text_pattern_ops"))])
  @@index([dataRoomId, updatedAt(sort: Desc)])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("files")
}

model FileVersion {
  id            String   @id @default(uuid()) @db.Uuid
  fileId        String   @db.Uuid
  versionNumber Int
  sizeBytes     BigInt
  contentType   String
  blobPathname  String   @unique
  uploadedById  String?  @db.Uuid
  createdAt     DateTime @default(now())

  file       File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([fileId, versionNumber])
  @@index([fileId, createdAt(sort: Desc)])
  @@map("file_versions")
}

model Share {
  id String @id @default(uuid()) @db.Uuid
  dataRoomId String @db.Uuid
  subjectType     ShareSubjectType
  subjectFolderId String?          @db.Uuid
  subjectFileId   String?          @db.Uuid
  mode ShareMode
  role ShareRole @default(VIEWER)
  granteeUserId String? @db.Uuid
  token         String? @unique
  createdById String    @db.Uuid
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  dataRoom      DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  subjectFolder Folder?  @relation(fields: [subjectFolderId], references: [id], onDelete: Cascade)
  subjectFile   File?    @relation(fields: [subjectFileId], references: [id], onDelete: Cascade)
  createdBy     User     @relation("ShareCreator", fields: [createdById], references: [id], onDelete: Cascade)
  grantee       User?    @relation("ShareGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@index([granteeUserId, revokedAt])
  @@index([dataRoomId, subjectType, revokedAt])
  @@map("shares")
}

enum ShareSubjectType {
  DATA_ROOM
  FOLDER
  FILE
}

enum ShareMode {
  PUBLIC_LINK
  RESTRICTED
}

enum ShareRole {
  VIEWER
}
