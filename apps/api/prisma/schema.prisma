// ---------------------------------------------------------------------------
// Data Room — data model
//
// Two ideas drive this schema:
//
//   1. `dataRoomId` is the partition key. Every content table carries it and
//      every composite index leads with it. No query is allowed to span data
//      rooms. The system runs on one Postgres instance today; if that ever
//      saturates, splitting on hash(dataRoomId) needs no remodelling.
//
//   2. Folders and files carry a materialised `path` of ancestor ids. One
//      prefix scan then answers three otherwise-awkward questions: list a
//      subtree, aggregate a subtree's size and count, and decide whether a
//      share on an ancestor covers a given item. Paths are built from ids
//      rather than names, so renaming is free — only moves rewrite paths.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled  — application queries
  directUrl = env("DIRECT_URL")   // direct  — migrations, studio, introspection
}

// The pg_trgm extension (needed by the trigram index on files.name) is created
// in the init migration rather than declared here. Prisma's `postgresqlExtensions`
// preview feature diffs *every* extension in the database, which reports
// Prisma Postgres's own built-in `prisma_postgres` extension as drift on every run.

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities     AuthIdentity[]
  dataRooms      DataRoom[]
  sharesCreated  Share[]        @relation("ShareCreator")
  sharesReceived Share[]        @relation("ShareGrantee")
  uploads        FileVersion[]

  @@map("users")
}

/// One row per sign-in method. Keeping credentials out of `User` lets the same
/// person hold a password and a Google identity without nullable columns
/// multiplying per provider — a third provider is a row, not a migration.
model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  /// Google's `sub`, or the normalised email for LOCAL.
  providerUserId String
  /// Bcrypt hash. Set for LOCAL only; null for federated providers.
  passwordHash   String?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

// ---------------------------------------------------------------------------
// Content tree
// ---------------------------------------------------------------------------

model DataRoom {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folders Folder[]
  files   File[]
  shares  Share[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("data_rooms")
}

model Folder {
  id         String  @id @default(uuid()) @db.Uuid
  dataRoomId String  @db.Uuid
  parentId   String? @db.Uuid
  name       String
  path  String
  depth Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataRoom DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  files    File[]
  shares   Share[]
  @@unique([parentId, name])
  @@index([dataRoomId, parentId, name])
  @@index([dataRoomId, path(ops: raw("text_pattern_ops"))])
  @@map("folders")
}

model File {
  id         String  @id @default(uuid()) @db.Uuid
  dataRoomId String  @db.Uuid
  folderId   String? @db.Uuid
  name       String
  path String
  sizeBytes     BigInt
  contentType   String
  blobPathname  String
  versionNumber Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataRoom DataRoom      @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder   Folder?       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  versions FileVersion[]
  shares   Share[]
  @@unique([folderId, name])
  @@index([dataRoomId, folderId, name])
  @@index([dataRoomId, path(ops: raw("text_pattern_ops"))])
  @@index([dataRoomId, updatedAt(sort: Desc)])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("files")
}

model FileVersion {
  id            String   @id @default(uuid()) @db.Uuid
  fileId        String   @db.Uuid
  versionNumber Int
  sizeBytes     BigInt
  contentType   String
  blobPathname  String   @unique
  uploadedById  String?  @db.Uuid
  createdAt     DateTime @default(now())

  file       File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([fileId, versionNumber])
  @@index([fileId, createdAt(sort: Desc)])
  @@map("file_versions")
}

model Share {
  id String @id @default(uuid()) @db.Uuid
  dataRoomId String @db.Uuid
  subjectType     ShareSubjectType
  subjectFolderId String?          @db.Uuid
  subjectFileId   String?          @db.Uuid
  mode ShareMode
  role ShareRole @default(VIEWER)
  granteeUserId String? @db.Uuid
  token         String? @unique
  createdById String    @db.Uuid
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  dataRoom      DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  subjectFolder Folder?  @relation(fields: [subjectFolderId], references: [id], onDelete: Cascade)
  subjectFile   File?    @relation(fields: [subjectFileId], references: [id], onDelete: Cascade)
  createdBy     User     @relation("ShareCreator", fields: [createdById], references: [id], onDelete: Cascade)
  grantee       User?    @relation("ShareGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@index([granteeUserId, revokedAt])
  @@index([dataRoomId, subjectType, revokedAt])
  @@map("shares")
}

enum ShareSubjectType {
  DATA_ROOM
  FOLDER
  FILE
}

enum ShareMode {
  PUBLIC_LINK
  RESTRICTED
}

enum ShareRole {
  VIEWER
}
