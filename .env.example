# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# Postgres values come from the Prisma Postgres resource in the Vercel
# dashboard; blob values from the Vercel Blob store's .env.local tab.
# ---------------------------------------------------------------------------

# Pooled connection — used by the application at runtime.
# Host is pooled.db.prisma.io
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/DATABASE?sslmode=require"

# Direct connection — used only by the Prisma CLI (migrate, studio, introspect).
# Host is db.prisma.io. Pointing this at the pooler makes migrations fail.
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/DATABASE?sslmode=require"

# Vercel Blob (private store). Needed to mint client upload tokens; OIDC
# covers the other calls once deployed.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXXXXXXXXXX"

# Auth
JWT_SECRET="generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Google OAuth — leave blank to disable the Google sign-in option.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Server
PORT="3001"
CORS_ORIGIN="http://localhost:3000"
